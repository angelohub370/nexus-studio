# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Recipient (defaults to contactnexusstudio96@gmail.com from site config)
CONTACT_TO_EMAIL=contactnexusstudio96@gmail.com

# Sender — use onboarding@resend.dev for testing (only sends to your Resend account email)
